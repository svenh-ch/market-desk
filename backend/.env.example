# Kopie als "backend/.env" speichern und bei Bedarf ausfüllen.
# Diese Datei wird nie in Git gespeichert. Nach Änderungen: "App neu bauen.command" doppelklicken.

# Nur lokal erreichbar (bitte so lassen)
HOST=127.0.0.1

# Optional: Claude-API-Key (für die spätere Lieferketten-Auswertung)
ANTHROPIC_API_KEY=

# Pflicht für SEC-Daten (Score, Lieferketten): deine Kontakt-E-Mail, verlangt von der SEC
SEC_CONTACT_EMAIL=deine.adresse@example.com
